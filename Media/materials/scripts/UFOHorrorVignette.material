fragment_program UFO/HorrorVignette_GLSL glsl glsles
{
    source UFOHorrorVignette.glsl
}

fragment_program UFO/HorrorVignette_HLSL hlsl
{
    source UFOHorrorVignette.cg
    entry_point HorrorVignette_ps
}

fragment_program UFO/HorrorVignette_FP unified
{
    delegate UFO/HorrorVignette_GLSL
    delegate UFO/HorrorVignette_HLSL
}

material UFO/HorrorVignette
{
    technique
    {
        pass
        {
            cull_hardware none
            depth_func always_pass
            polygon_mode_overrideable false

            vertex_program_ref Ogre/Compositor/StdQuad_Tex2a_vp
            {
            }

            fragment_program_ref UFO/HorrorVignette_FP
            {
            }

            texture_unit RT
            {
                tex_coord_set 0
                tex_address_mode clamp
                filtering trilinear
            }
        }
    }
}
