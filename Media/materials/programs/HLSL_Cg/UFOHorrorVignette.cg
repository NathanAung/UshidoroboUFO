sampler2D RT : register(s0);

float4 HorrorVignette_ps(float4 pos : POSITION, float2 uv : TEXCOORD0) : COLOR
{
    float2 p = uv - float2(0.5, 0.55);
    p.x *= 1.45;

    float distanceFromCenter = length(p);
    float t = saturate((distanceFromCenter - 0.34) / (0.82 - 0.34));
    float vignette = t * t * (3.0 - 2.0 * t);
    float exposure = 1.0 - 0.82 * vignette;
    float4 scene = tex2D(RT, uv);
    float3 coolShadow = float3(0.008, 0.016, 0.04) * vignette;

    return float4(scene.rgb * exposure + coolShadow, scene.a);
}
