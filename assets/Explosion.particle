// 1. The Large Death Explosion
particle_system UFO/Explosion
{
    material        Examples/Flare
    particle_width  35
    particle_height 35
    quota           500
    billboard_type  point

    emitter Point
    {
        angle           180
        emission_rate   3000
        time_to_live    1.5    // Increased lifespan
        duration        0.2
        velocity_min    60
        velocity_max    200
        
        colour_range_start  1.0 0.8 0.1 1.0
        colour_range_end    1.0 0.5 0.0 1.0
    }

    affector ColourInterpolator
    {
        time0 0.0
        colour0 1.0 0.6 0.0 1.0 
        time1 0.4
        colour1 1.0 0.1 0.0 1.0 
        time2 0.7
        colour2 0.5 0.0 0.0 0.5 
        time3 1.0
        colour3 0.0 0.0 0.0 0.0 
    }
}

// 2. The Small Normal Damage Explosion
particle_system UFO/SmallExplosion
{
    material        Examples/Flare
    particle_width  15
    particle_height 15
    quota           100
    billboard_type  point

    emitter Point
    {
        angle           180
        emission_rate   1000
        time_to_live    0.5    // Shorter lifespan
        duration        0.1
        velocity_min    30
        velocity_max    80
        
        colour_range_start  1.0 0.8 0.1 1.0
        colour_range_end    1.0 0.5 0.0 1.0
    }

    affector ColourInterpolator
    {
        time0 0.0
        colour0 1.0 0.6 0.0 1.0 
        time1 0.4
        colour1 1.0 0.1 0.0 1.0 
        time2 0.7
        colour2 0.5 0.0 0.0 0.5 
        time3 1.0
        colour3 0.0 0.0 0.0 0.0 
    }
}